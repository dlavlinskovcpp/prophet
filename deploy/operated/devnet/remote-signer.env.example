# Copy to remote-signer.env and replace all example secrets before use.

APP_ENV=production
ALLOW_LOCAL_NOTARY_KEYS=0
NOTARY_KEYPAIR_PATHS=

REMOTE_SIGNER_REQUIRE_AUTH=1
REMOTE_SIGNER_API_KEY=replace-me
REMOTE_SIGNER_REQUIRE_ALLOWLIST=1
REMOTE_SIGNER_ALLOWLIST_MODE=file
REMOTE_SIGNER_ALLOWED_PUBKEYS=
REMOTE_SIGNER_ALLOWED_PUBKEYS_PATH=/app/signer_allowlist.txt
REMOTE_SIGNER_ALLOWLIST_REFRESH_S=30
REMOTE_SIGNER_MAX_MESSAGE_BYTES=10000

REMOTE_SIGNER_BACKEND=aws_kms
REMOTE_SIGNER_COMMAND=
REMOTE_SIGNER_COMMAND_TIMEOUT_S=5
REMOTE_SIGNER_AWS_KMS_KEY_IDS=alias/prophet-devnet-notary
REMOTE_SIGNER_AWS_KMS_REGION=us-east-1
REMOTE_SIGNER_AWS_KMS_ENDPOINT_URL=
REMOTE_SIGNER_AWS_KMS_TIMEOUT_S=5

REMOTE_SIGNER_AUDIT_LOG_PATH=/app/audit/remote-signer.jsonl
RATE_LIMIT_ENABLED=1
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_TRUST_X_FORWARDED_FOR=1
METRICS_ENABLED=1

