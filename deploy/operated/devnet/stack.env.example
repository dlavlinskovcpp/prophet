# Copy to stack.env and update these values, then run:
# python3 scripts/render_operated_stack.py --environment devnet

# Public secure-settlement service URLs copied into deploy/environments/devnet.json.
VERIFIER_A_BASE_URL=https://verifier-a.devnet.prophet.example
VERIFIER_B_BASE_URL=https://verifier-b.devnet.prophet.example
COORDINATOR_BASE_URL=https://coordinator.devnet.prophet.example
SECURE_SETTLEMENT_BASE_URL=https://settlement.devnet.prophet.example
RESOLVER_REGISTRY_PUBLIC_URL=https://resolver-registry.devnet.prophet.example/resolvers
MATCHING_KEEPER_BASE_URL=https://matching-keeper.devnet.prophet.example

# Independent zkTLS proof-verifier backends. These must be different services.
VERIFIER_A_PROOF_BACKEND_URL=https://zktls-primary.devnet.prophet.example/verify
VERIFIER_B_PROOF_BACKEND_URL=https://zktls-independent.devnet.prophet.example/verify
VERIFIER_A_IDENTITY=prophet.verifier.runtime.a
VERIFIER_B_IDENTITY=prophet.verifier.runtime.b
VERIFIER_A_AUTH_REF=devnet:verifier-a-auth
VERIFIER_B_AUTH_REF=devnet:verifier-b-auth

# Mandatory secure settlement policy.
RESOLUTION_MODE=secure-coordinator
DIRECT_ATTESTER_SETTLEMENT_ENABLED=0
GENERIC_REMOTE_SIGNER_SETTLEMENT_ENABLED=0
STRICT_SIGNER_COUNT=2
COORDINATOR_SQLITE_PATH=/var/lib/prophet/devnet/coordinator.sqlite
SIGNING_JOURNAL_PATH=/var/lib/prophet/devnet/signing-journal.sqlite
SUBMISSION_JOURNAL_PATH=/var/lib/prophet/devnet/submission-journal.sqlite
SIGNER_A_IDENTITY=devnet-settlement-a
SIGNER_B_IDENTITY=devnet-settlement-b
SIGNER_A_VAULT_KEY=devnet:vault:settlement-a
SIGNER_B_VAULT_KEY=devnet:vault:settlement-b
SIGNER_A_AUTH_REF=devnet:vault-policy-a
SIGNER_B_AUTH_REF=devnet:vault-policy-b

# Chain connectivity.
RPC_URL=https://api.devnet.solana.com
WS_URL=wss://api.devnet.solana.com/
PROPHET_PROGRAM_ID=913Xp7ck53fMFTjGdKtjiwQXsBa4SfC9hce1SVGr3G9A

# Compose runtime roots. Secure verifier/coordinator/settlement env files and
# Vault tokens are provisioned separately under PROPHET_SECRET_ROOT.
PROPHET_RUNTIME_ROOT=/var/lib/prophet/devnet
PROPHET_SECRET_ROOT=/etc/prophet/devnet
RESOLVER_REGISTRY_SERVICE_API_KEY=replace-me

# Optional matching keeper overrides.
MARKET_DISCOVERY_MODE=program_scan
MARKETS=
COMPUTE_UNIT_LIMIT=
COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=
LOG_LEVEL=INFO
