# Copy to stack.env and update these values, then run:
# python3 scripts/render_operated_stack.py --environment devnet

# Public service URLs copied into deploy/environments/devnet.json.
ATTESTER_BASE_URL=https://oracle-attester.devnet.prophet.example
REMOTE_SIGNER_PUBLIC_URL=https://remote-signer.devnet.prophet.example/sign
RESOLVER_REGISTRY_PUBLIC_URL=https://resolver-registry.devnet.prophet.example/resolvers
MATCHING_KEEPER_BASE_URL=https://matching-keeper.devnet.prophet.example

# Chain connectivity.
RPC_URL=https://api.devnet.solana.com
WS_URL=wss://api.devnet.solana.com/
PROPHET_PROGRAM_ID=913Xp7ck53fMFTjGdKtjiwQXsBa4SfC9hce1SVGr3G9A

# Compose runtime roots.
PROPHET_RUNTIME_ROOT=/var/lib/prophet/devnet
PROPHET_SECRET_ROOT=/etc/prophet/devnet

# Internal service URLs used by the compose stack.
REMOTE_SIGNER_INTERNAL_URL=http://remote-signer:8100/sign
RESOLVER_REGISTRY_INTERNAL_URL=http://resolver-registry:8200/resolvers

# Attester and service auth.
RECLAIM_VERIFY_URL=https://reclaim-verifier.devnet.prophet.example/verify
RECLAIM_API_KEY=
REMOTE_SIGNER_API_KEY=replace-me
RESOLVER_REGISTRY_SERVICE_API_KEY=replace-me
API_AUTH_TOKEN=replace-me

# Remote signer KMS backend.
REMOTE_SIGNER_AWS_KMS_REGION=us-east-1
REMOTE_SIGNER_AWS_KMS_KEY_IDS=alias/prophet-devnet-notary
REMOTE_SIGNER_AWS_KMS_ENDPOINT_URL=

# Optional matching keeper overrides.
MARKET_DISCOVERY_MODE=program_scan
MARKETS=
COMPUTE_UNIT_LIMIT=
COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=
LOG_LEVEL=INFO
