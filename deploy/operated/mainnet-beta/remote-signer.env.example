# Copy to remote-signer.env and replace all example secrets before use.

APP_ENV=production
ALLOW_LOCAL_NOTARY_KEYS=0
NOTARY_KEYPAIR_PATHS=

REMOTE_SIGNER_REQUIRE_AUTH=1
REMOTE_SIGNER_API_KEY=replace-me
REMOTE_SIGNER_REQUIRE_ALLOWLIST=1
REMOTE_SIGNER_ALLOWLIST_MODE=file
REMOTE_SIGNER_ALLOWED_PUBKEYS=
REMOTE_SIGNER_ALLOWED_PUBKEYS_PATH=/app/signer_allowlist.txt
REMOTE_SIGNER_ALLOWLIST_REFRESH_S=30
REMOTE_SIGNER_MAX_MESSAGE_BYTES=10000

# Default operated path: HashiCorp Vault Transit via the command backend.
REMOTE_SIGNER_BACKEND=command
REMOTE_SIGNER_COMMAND=python /app/scripts/vault_transit_signer.py
REMOTE_SIGNER_COMMAND_TIMEOUT_S=5
# Populate from `make signer-vault-bootstrap`.
REMOTE_SIGNER_COMMAND_PUBLIC_KEYS=

VAULT_ADDR=https://vault.mainnet-beta.prophet.example
VAULT_NAMESPACE=
VAULT_TOKEN_FILE=/app/remote-signer-secrets/vault-token
VAULT_CACERT=/app/remote-signer-secrets/vault-ca.pem
VAULT_SKIP_VERIFY=0
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY_NAME=
VAULT_TRANSIT_KEY_MAP_PATH=/app/remote-signer-secrets/vault-transit-key-map.json
VAULT_TRANSIT_TIMEOUT_S=5

# Optional legacy AWS KMS backend values if you explicitly switch REMOTE_SIGNER_BACKEND=aws_kms.
REMOTE_SIGNER_AWS_KMS_KEY_IDS=
REMOTE_SIGNER_AWS_KMS_REGION=
REMOTE_SIGNER_AWS_KMS_ENDPOINT_URL=
REMOTE_SIGNER_AWS_KMS_TIMEOUT_S=5

REMOTE_SIGNER_AUDIT_LOG_PATH=/app/audit/remote-signer.jsonl
RATE_LIMIT_ENABLED=1
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX_IDENTITIES=10000
# Enable XFF trust only behind a proxy that sanitizes/overwrites the header.
RATE_LIMIT_TRUST_X_FORWARDED_FOR=0
METRICS_ENABLED=1
