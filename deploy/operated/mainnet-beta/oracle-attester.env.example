# Copy to oracle-attester.env and replace all example secrets before use.

RPC_URL=https://api.mainnet-beta.solana.com
PROPHET_PROGRAM_ID=913Xp7ck53fMFTjGdKtjiwQXsBa4SfC9hce1SVGr3G9A

ORACLE_KEYPAIR_PATH=/app/oracle-keypair.json
RELAYER_KEYPAIR_PATH=/app/relayer-keypair.json
PROOF_STORE_DIR=/app/proof_store

APP_ENV=production
ZKTLS_MODE=reclaim_http
REQUIRE_ZKTLS=1
RECLAIM_VERIFY_URL=https://reclaim-verifier.mainnet-beta.prophet.example/verify
RECLAIM_API_KEY=replace-me
ZKTLS_HTTP_TIMEOUT_S=10

PROOF_FETCH_MODE=local
PROOF_FETCH_URL=
PROOF_FETCH_API_KEY=

NOTARY_SIGNER_MODE=remote
ALLOW_LOCAL_NOTARY_KEYS=0
NOTARY_KEYPAIR_PATHS=
REMOTE_SIGNER_URL=http://remote-signer:8100/sign
REMOTE_SIGNER_API_KEY=replace-me
REMOTE_SIGNER_TIMEOUT_S=5
REMOTE_SIGNER_REQUIRE_TLS=0

RESOLVER_REGISTRY_MODE=http
RESOLVER_REGISTRY_URL=http://resolver-registry:8200/resolvers
RESOLVER_REGISTRY_API_KEY=replace-me
RESOLVER_REGISTRY_TIMEOUT_S=5
RESOLVER_REGISTRY_REQUIRE_TLS=0
RESOLVER_REGISTRY_CACHE_TTL_S=300
RESOLVER_REGISTRY_CACHE_MAX_ENTRIES=1024
RESOLVER_REGISTRY_ALLOW_STALE_ON_ERROR=1

ATTESTER_AUDIT_LOG_PATH=/app/audit/attester.jsonl
REQUIRE_API_AUTH=1
API_AUTH_TOKEN=replace-me
RATE_LIMIT_ENABLED=1
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_TRUST_X_FORWARDED_FOR=1
MAX_REQUEST_BYTES=1000000
METRICS_ENABLED=1

