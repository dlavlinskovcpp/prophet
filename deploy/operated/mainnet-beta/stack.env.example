# Copy to stack.env and update these values, then run:
# python3 scripts/render_operated_stack.py --environment mainnet-beta

# Public service metadata copied into deploy/environments/mainnet-beta.json.
VERIFIER_A_BASE_URL=https://verifier-a.mainnet-beta.prophet.example
VERIFIER_B_BASE_URL=https://verifier-b.mainnet-beta.prophet.example
COORDINATOR_BASE_URL=https://coordinator.mainnet-beta.prophet.example
SECURE_SETTLEMENT_BASE_URL=https://settlement.mainnet-beta.prophet.example
RESOLVER_REGISTRY_PUBLIC_URL=https://resolver-registry.mainnet-beta.prophet.example/resolvers
MATCHING_KEEPER_BASE_URL=https://matching-keeper.mainnet-beta.prophet.example

# Independent zkTLS proof-verifier backends. These must be different services.
VERIFIER_A_PROOF_BACKEND_URL=https://zktls-primary.mainnet-beta.prophet.example/verify
VERIFIER_B_PROOF_BACKEND_URL=https://zktls-independent.mainnet-beta.prophet.example/verify
VERIFIER_A_IDENTITY=prophet.verifier.runtime.a
VERIFIER_B_IDENTITY=prophet.verifier.runtime.b
VERIFIER_A_AUTH_REF=mainnet-beta:verifier-a-auth
VERIFIER_B_AUTH_REF=mainnet-beta:verifier-b-auth

# Mandatory secure settlement policy.
RESOLUTION_MODE=secure-coordinator
DIRECT_ATTESTER_SETTLEMENT_ENABLED=0
GENERIC_REMOTE_SIGNER_SETTLEMENT_ENABLED=0
STRICT_SIGNER_COUNT=2
COORDINATOR_SQLITE_PATH=/var/lib/prophet/mainnet-beta/coordinator/coordinator.sqlite
SIGNING_JOURNAL_PATH=/var/lib/prophet/mainnet-beta/signing/signing-journal.sqlite
SUBMISSION_JOURNAL_PATH=/var/lib/prophet/mainnet-beta/submission/submission-journal.sqlite
SIGNER_A_IDENTITY=mainnet-beta-settlement-a
SIGNER_B_IDENTITY=mainnet-beta-settlement-b
SIGNER_A_VAULT_KEY=mainnet-beta:vault:settlement-a
SIGNER_B_VAULT_KEY=mainnet-beta:vault:settlement-b

# Chain connectivity.
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com/
PROPHET_PROGRAM_ID=913Xp7ck53fMFTjGdKtjiwQXsBa4SfC9hce1SVGr3G9A

# Compose runtime roots. Role-local signer secrets are never placed here.
PROPHET_RUNTIME_ROOT=/var/lib/prophet/mainnet-beta
PROPHET_SECRET_ROOT=/etc/prophet/mainnet-beta
RESOLVER_REGISTRY_SERVICE_API_KEY=replace-me

# Optional matching keeper overrides.
MARKET_DISCOVERY_MODE=program_scan
MARKETS=
COMPUTE_UNIT_LIMIT=
COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=
LOG_LEVEL=INFO
