# Copy to stack.env and update these values, then run:
# python3 scripts/render_operated_stack.py --environment mainnet-beta

# Public service URLs copied into deploy/environments/mainnet-beta.json.
ATTESTER_BASE_URL=https://oracle-attester.mainnet-beta.prophet.example
REMOTE_SIGNER_PUBLIC_URL=https://remote-signer.mainnet-beta.prophet.example/sign
RESOLVER_REGISTRY_PUBLIC_URL=https://resolver-registry.mainnet-beta.prophet.example/resolvers
MATCHING_KEEPER_BASE_URL=https://matching-keeper.mainnet-beta.prophet.example

# Chain connectivity.
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com/
PROPHET_PROGRAM_ID=913Xp7ck53fMFTjGdKtjiwQXsBa4SfC9hce1SVGr3G9A

# Compose runtime roots.
PROPHET_RUNTIME_ROOT=/var/lib/prophet/mainnet-beta
PROPHET_SECRET_ROOT=/etc/prophet/mainnet-beta

# Internal service URLs used by the compose stack.
REMOTE_SIGNER_INTERNAL_URL=http://remote-signer:8100/sign
RESOLVER_REGISTRY_INTERNAL_URL=http://resolver-registry:8200/resolvers

# Attester and service auth.
RECLAIM_VERIFY_URL=https://reclaim-verifier.mainnet-beta.prophet.example/verify
RECLAIM_API_KEY=
REMOTE_SIGNER_API_KEY=replace-me
RESOLVER_REGISTRY_SERVICE_API_KEY=replace-me
API_AUTH_TOKEN=replace-me

# Remote signer backend.
REMOTE_SIGNER_BACKEND=command
REMOTE_SIGNER_COMMAND=python /app/scripts/vault_transit_signer.py
REMOTE_SIGNER_COMMAND_TIMEOUT_S=5
# Populate from `make signer-vault-bootstrap`.
REMOTE_SIGNER_COMMAND_PUBLIC_KEYS=
VAULT_ADDR=https://vault.mainnet-beta.prophet.example
VAULT_NAMESPACE=
VAULT_TOKEN_FILE=/app/remote-signer-secrets/vault-token
VAULT_CACERT=/app/remote-signer-secrets/vault-ca.pem
VAULT_SKIP_VERIFY=0
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY_NAMES=prophet-mainnet-notary-01
VAULT_TRANSIT_KEY_NAME=
VAULT_TRANSIT_KEY_MAP_PATH=/app/remote-signer-secrets/vault-transit-key-map.json
VAULT_TRANSIT_TIMEOUT_S=5

# Legacy AWS KMS backend values. Only required when REMOTE_SIGNER_BACKEND=aws_kms.
REMOTE_SIGNER_AWS_KMS_REGION=
REMOTE_SIGNER_AWS_KMS_KEY_IDS=
REMOTE_SIGNER_AWS_KMS_ENDPOINT_URL=

# Optional matching keeper overrides.
MARKET_DISCOVERY_MODE=program_scan
MARKETS=
COMPUTE_UNIT_LIMIT=
COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=
LOG_LEVEL=INFO
