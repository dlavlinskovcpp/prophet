# Copy to resolver-registry.env and replace all example secrets before use.

APP_ENV=production
RESOLVER_STORE_DIR=/app/resolver_store
RESOLVER_REGISTRY_REQUIRE_AUTH=1
RESOLVER_REGISTRY_SERVICE_API_KEY=replace-me
RESOLVER_REGISTRY_MAX_REQUEST_BYTES=100000
RESOLVER_REGISTRY_AUDIT_LOG_PATH=/app/audit/resolver-registry.jsonl

RATE_LIMIT_ENABLED=1
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_TRUST_X_FORWARDED_FOR=1
METRICS_ENABLED=1

