# Copy outside Git to /etc/prophet/public-devnet/runtime.env (mode 0600).
# This file contains public/logical topology only. Actual bearer/Vault tokens live
# in service-specific secret env files under PROPHET_SECRET_ROOT.
PROPHET_RUNTIME_ROOT=/var/lib/prophet/public-devnet
PROPHET_SECRET_ROOT=/etc/prophet/public-devnet
RPC_URL=https://api.devnet.solana.com
WS_URL=wss://api.devnet.solana.com
EXPECTED_CLUSTER=devnet
EXPECTED_CLUSTER_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
EXPECTED_PROPHET_PROGRAM_ID=3AUW4eLPigqyHmQNapcmv3JSYw6s8Aa5PPf87ayGT8kE
RESOLVER_V2_SCHEMA_VERSION=2.0.0

RESOLUTION_MODE=secure-coordinator
DIRECT_ATTESTER_SETTLEMENT_ENABLED=0
GENERIC_REMOTE_SIGNER_SETTLEMENT_ENABLED=0
STRICT_SIGNER_COUNT=2

VERIFIER_A_URL=http://verifier-a:8301
VERIFIER_B_URL=http://verifier-b:8302
VERIFIER_A_IDENTITY=prophet.verifier.runtime.a
VERIFIER_B_IDENTITY=prophet.verifier.runtime.b
VERIFIER_A_AUTH_REF=PROPHET_VERIFIER_A_INTERNAL_TOKEN
VERIFIER_B_AUTH_REF=PROPHET_VERIFIER_B_INTERNAL_TOKEN
VERIFIER_A_PROOF_BACKEND_URL=CONFIGURE_INDEPENDENT_PRIMARY_ZKTLS_HTTPS_URL
VERIFIER_B_PROOF_BACKEND_URL=CONFIGURE_INDEPENDENT_SECONDARY_ZKTLS_HTTPS_URL
COORDINATOR_URL=http://coordinator:8400
COORDINATOR_SQLITE_PATH=/var/lib/prophet/public-devnet/coordinator/coordinator.sqlite
SIGNING_JOURNAL_PATH=/var/lib/prophet/public-devnet/signing/signing-journal.sqlite
SUBMISSION_JOURNAL_PATH=/var/lib/prophet/public-devnet/submission/submission-journal.sqlite

SIGNER_POLICY_VERSION=REPLACE_AFTER_MANAGED_ROTATION
MANAGED_SIGNER_A_PUBLIC_KEY=FWq7715Lzdzn3ofYr5HHVSNh1dLAmkiFxNpfUTh2h3vf
MANAGED_SIGNER_B_PUBLIC_KEY=4mrX5LqBtoRWapJT6bijDkpThCoYNcDmQkcfXchWhE14
SIGNER_A_IDENTITY=public-devnet-settlement-a
SIGNER_B_IDENTITY=public-devnet-settlement-b
SIGNER_A_VAULT_KEY=prophet-public-devnet-settlement-a
SIGNER_B_VAULT_KEY=prophet-public-devnet-settlement-b

ALERT_RECEIVER_CONFIGURED=0
ALERTMANAGER_CONFIG_FILE=/run/secrets/alertmanager.yml
GRAFANA_ADMIN_PASSWORD__FILE=/run/secrets/grafana-admin-password
