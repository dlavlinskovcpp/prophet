# Copy outside Git to /etc/prophet/public-devnet/runtime.env (mode 0600).
# Values ending in _FILE point to mounted secret files; no secret belongs here.
PROPHET_RUNTIME_ROOT=/var/lib/prophet/public-devnet
PROPHET_SECRET_ROOT=/etc/prophet/public-devnet
RPC_URL=https://api.devnet.solana.com
WS_URL=wss://api.devnet.solana.com
EXPECTED_CLUSTER=devnet
EXPECTED_CLUSTER_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
EXPECTED_PROPHET_PROGRAM_ID=3AUW4eLPigqyHmQNapcmv3JSYw6s8Aa5PPf87ayGT8kE
RESOLVER_V2_SCHEMA_VERSION=2.0.0
SIGNER_POLICY_VERSION=REPLACE_AFTER_MANAGED_ROTATION
MANAGED_SIGNER_A_PUBLIC_KEY=REPLACE_AFTER_VAULT_BOOTSTRAP
MANAGED_SIGNER_B_PUBLIC_KEY=REPLACE_AFTER_VAULT_BOOTSTRAP
VAULT_ADDR=https://vault:8200
VAULT_TRANSIT_MOUNT=transit
VAULT_TOKEN_FILE=/run/secrets/vault-token
VAULT_CACERT=/run/secrets/vault-ca.pem
ALERT_RECEIVER_CONFIGURED=0
ALERTMANAGER_CONFIG_FILE=/run/secrets/alertmanager.yml
GRAFANA_ADMIN_PASSWORD__FILE=/run/secrets/grafana-admin-password
