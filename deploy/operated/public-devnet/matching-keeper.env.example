# Copy to matching-keeper.env and replace deployment-specific values before use.
ENVIRONMENT=public-devnet
RPC_URL=https://api.devnet.solana.com
WS_URL=wss://api.devnet.solana.com/
PROPHET_PROGRAM_ID=3AUW4eLPigqyHmQNapcmv3JSYw6s8Aa5PPf87ayGT8kE
PAYER_KEYPAIR_PATH=/run/secrets/keeper-id.json
MARKET_DISCOVERY_MODE=explicit
MARKETS=
REQUIRE_NOTARY_CONFIG=1
DB_PATH=/app/apps/matching-keeper/state/matcher.db
POLL_MS=250
SNAPSHOT_RESYNC_S=300
DISCOVERY_INTERVAL_S=60
MAX_DISCOVERED_MARKETS=500
MATCH_ATTEMPT_RETENTION_DAYS=30
PRUNE_INTERVAL_S=3600
STALE_WS_THRESHOLD_S=120
MAX_QTY_ATOMS=1000000
MAX_MATCHES_PER_MARKET=10
REQUIRE_OPERATED_RESOLVER_SUPPORT=1
OPERATED_SUPPORTED_RESOLVER_HASHES=
COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=
OPS_HOST=127.0.0.1
OPS_PORT=8010
OPS_PROTECTED_INGRESS=0
OPS_EXPOSE_MARKETS=0
OPS_EXPOSE_ATTEMPTS=0
OPS_EXPOSE_METRICS=0
LOG_LEVEL=INFO
