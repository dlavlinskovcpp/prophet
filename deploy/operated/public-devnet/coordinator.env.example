# Copy to /etc/prophet/public-devnet/coordinator.env with mode 0600.
PROPHET_COORDINATOR_INTERNAL_TOKEN=REPLACE_WITH_COORDINATOR_TOKEN
PROPHET_VERIFIER_A_INTERNAL_TOKEN=REPLACE_WITH_VERIFIER_A_TOKEN
PROPHET_VERIFIER_B_INTERNAL_TOKEN=REPLACE_WITH_VERIFIER_B_TOKEN
PROPHET_SIGNER_A_GRANT_PATH=/var/lib/prophet/public-devnet/coordinator/grants/signer-a.json
PROPHET_SIGNER_B_GRANT_PATH=/var/lib/prophet/public-devnet/coordinator/grants/signer-b.json
PROPHET_SOLANA_RPC_URL=https://api.devnet.solana.com
PROPHET_COORDINATOR_FEE_PAYER_KEYPAIR=/run/secrets/coordinator-fee-payer.json
