# Matching keeper local/operator template.
# PROPHET_PROGRAM_ID is required and intentionally has no default.
PROPHET_PROGRAM_ID=

RPC_URL=http://127.0.0.1:8899
WS_URL=ws://127.0.0.1:8900
PAYER_KEYPAIR_PATH=./id.json

MARKET_DISCOVERY_MODE=program_scan
MARKETS=
REQUIRE_NOTARY_CONFIG=1
DB_PATH=./state/matcher.db
POLL_MS=250
SNAPSHOT_RESYNC_S=300
DISCOVERY_INTERVAL_S=60
MAX_DISCOVERED_MARKETS=500
MATCH_ATTEMPT_RETENTION_DAYS=30
PRUNE_INTERVAL_S=3600
STALE_WS_THRESHOLD_S=120
MAX_QTY_ATOMS=1000000
MAX_MATCHES_PER_MARKET=10
LOG_LEVEL=INFO
